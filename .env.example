# .env.example
# ─────────────────────────────────────────────
# Bu dosyayı `.env` olarak kopyala ve kendi anahtarlarını yaz.
# `.env` dosyası .gitignore'da — asla depoya gönderilmez.
#   cp .env.example .env
# ─────────────────────────────────────────────

# Anthropic API — Claude ajanları (teknik/risk/karar/haber)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Binance Futures API — veri çekme + emir gönderme
# Testnet: https://testnet.binancefuture.com
# Gerçek:  https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# True  → Binance Futures Testnet (sahte para)
# False → GERÇEK PARA. Değiştirmeden önce iki kez düşün.
TESTNET=True

# Telegram Bot bildirimleri (opsiyonel — boş bırakılırsa bildirim gitmez)
# Token: @BotFather'dan bot oluştur
# Chat ID: @userinfobot'a yaz
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
